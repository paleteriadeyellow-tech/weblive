# Copia este archivo a .env y pega tu API key de https://www.eulerstream.com
# En Render: Environment → EULER_API_KEY (no subas .env al repo).
EULER_API_KEY=euler_tu_clave_aqui

# PayPal (Premium 1 mes). Estas claves van en Render.
# 1) https://developer.paypal.com → Apps → Create App (Live)
# 2) Client ID + Secret
# 3) Webhooks → Add webhook:
#    URL: https://livecoins.onrender.com/api/paypal/webhook
#    Eventos: PAYMENT.CAPTURE.COMPLETED y CHECKOUT.ORDER.APPROVED
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=live
PAYPAL_CURRENCY=USD
PAYPAL_PREMIUM_AMOUNT=17
PAYPAL_PREMIUM_DAYS=30
# PAYPAL_PUBLIC_BASE=https://livecoins.onrender.com
